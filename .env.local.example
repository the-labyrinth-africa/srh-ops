MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# PWA terrain (service worker + cache hors-ligne) : désactivée par défaut.
# Les défauts connus de l'outbox et du service worker (cache des navigations
# authentifiées, RSC servis en cache-first) doivent être corrigés avant de
# l'activer. Quand la variable vaut autre chose que "true", l'application
# désinstalle tout service worker déjà présent et vide les caches srh-ops-*.
# NEXT_PUBLIC_ENABLE_PWA="false"

# E-mail (SMTP) — expéditeur SRH. Le mot de passe se renseigne UNIQUEMENT dans .env.local
# (ignoré par Git) et dans les variables d'environnement Vercel (mode Sensitive).
SMTP_HOST=mail.thelabyrinth.africa
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@thelabyrinth.africa
SMTP_PASSWORD=
MAIL_FROM="SRH <contact@thelabyrinth.africa>"
